# =============================================================================
#  LifeofM — variables d'environnement
#  Copiez ce fichier en `.env` puis completez les valeurs.
#  Seules les variables ci-dessous sont lues par l'application (src/lib/env.ts
#  et Prisma). Ne commitez jamais `.env`.
# =============================================================================

# --- Base de donnees ---------------------------------------------------------
# Developpement (SQLite, aucune installation) : `npm run db:use sqlite`
DATABASE_URL="file:./dev.db"
# Production (PostgreSQL) : `npm run db:use postgresql`
# DATABASE_URL="postgresql://lifeofm:lifeofm@localhost:5432/lifeofm?schema=public"

# --- Application -------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Securite ----------------------------------------------------------------
# OBLIGATOIRE en production (la valeur d'exemple y est refusee). Generez-en une :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="dev-secret-change-me-in-production-please-32-chars-min"
# Duree de vie de la session, en jours
REFRESH_TOKEN_TTL_DAYS="30"

# --- Agent IA (Anthropic) ----------------------------------------------------
# Laisser la cle vide desactive proprement l'agent (l'UI affiche un message).
ANTHROPIC_API_KEY=""
AI_MODEL="claude-sonnet-5"

# --- Email (reinitialisation du mot de passe) --------------------------------
# Sans SMTP configure, les emails sont ecrits dans la console du serveur.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="LifeofM <no-reply@lifeofm.app>"

# --- APIs externes -----------------------------------------------------------
# Meteo — https://openweathermap.org/api (gratuit, optionnelle)
OPENWEATHER_API_KEY=""
# Horaires de priere (AlAdhan) et geocodage (Nominatim) : publics, sans cle
ALADHAN_API_URL="https://api.aladhan.com/v1"
NOMINATIM_URL="https://nominatim.openstreetmap.org"
