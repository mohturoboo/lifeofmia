# =============================================================================
#  LifeofM — variables d'environnement
#  Copiez ce fichier en `.env` puis completez les valeurs.
# =============================================================================

# --- Base de donnees ---------------------------------------------------------
# Developpement (aucune installation requise) :
DATABASE_URL="file:./dev.db"
# Production PostgreSQL — pensez a `npm run db:use postgresql` :
# DATABASE_URL="postgresql://lifeofm:lifeofm@localhost:5432/lifeofm?schema=public"

# --- Application -------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# --- Securite ----------------------------------------------------------------
# OBLIGATOIRE en production. Generez une valeur avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="dev-secret-change-me-in-production-please-32-chars-min"
# Duree de vie des jetons
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS="30"
# Cle de chiffrement AES-256-GCM des donnees sensibles (32 octets en base64url)
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ENCRYPTION_KEY=""

# --- Agent IA (Claude) -------------------------------------------------------
ANTHROPIC_API_KEY=""
AI_MODEL="claude-sonnet-5"
# Laisser vide desactive proprement l'agent (l'UI affiche un message dedie).

# --- Email (verification, reinitialisation) ----------------------------------
# Sans SMTP configure, les emails sont ecrits dans la console du serveur.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="LifeofM <no-reply@lifeofm.app>"

# --- APIs externes -----------------------------------------------------------
# Meteo — https://openweathermap.org/api (gratuit)
OPENWEATHER_API_KEY=""
# Horaires de priere — AlAdhan est public, aucune cle requise
ALADHAN_API_URL="https://api.aladhan.com/v1"
# Geocodage inverse — OpenStreetMap Nominatim, aucune cle requise
NOMINATIM_URL="https://nominatim.openstreetmap.org"

# --- OAuth (optionnel) -------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""

# --- Stockage fichiers (optionnel) -------------------------------------------
# Par defaut : stockage local dans /public/uploads
STORAGE_DRIVER="local"
SUPABASE_URL=""
SUPABASE_SERVICE_KEY=""
SUPABASE_BUCKET="lifeofm"

# --- Notifications push (optionnel) ------------------------------------------
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
