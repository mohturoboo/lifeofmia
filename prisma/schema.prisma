// =============================================================================
//  LifeofM — Schema de donnees
// -----------------------------------------------------------------------------
//  Le provider est pilote par le script `npm run db:use <sqlite|postgresql>`.
//  Le schema est volontairement ecrit dans un sous-ensemble compatible avec les
//  deux moteurs :
//    - pas d'`enum`      -> champs String documentes + validation Zod applicative
//    - pas de `Json`     -> String contenant du JSON serialise (helpers dans lib/json.ts)
//    - pas de `String[]` -> meme principe
//  Cela garantit que le meme schema tourne en SQLite (dev) et PostgreSQL (prod).
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
//  IDENTITE & COMPTE
// -----------------------------------------------------------------------------

model User {
  id        String  @id @default(cuid())
  email     String  @unique
  password  String? // hash bcrypt — null si compte OAuth pur
  firstName String
  lastName  String
  avatarUrl String?

  // Localisation & preferences
  country    String  @default("FR")
  city       String  @default("Paris")
  latitude   Float?
  longitude  Float?
  timezone   String  @default("Europe/Paris")
  locale     String  @default("fr") // fr | en | ar | es | de | it | pt | tr
  theme      String  @default("dark") // dark | light | system
  timeFormat String  @default("24h") // 12h | 24h
  units      String  @default("metric") // metric | imperial
  glassMl    Int     @default(250) // contenance d'un verre, pour le suivi d'hydratation

  // Profil personnel
  birthDate DateTime?
  gender    String? // male | female | other
  heightCm  Float?
  mainGoal  String? // objectif principal affiche sur le dashboard

  // Securite
  emailVerified     DateTime?
  twoFactorEnabled  Boolean   @default(false)
  twoFactorSecret   String?
  failedLoginCount  Int       @default(0)
  lockedUntil       DateTime?
  lastLoginAt       DateTime?

  // Gamification
  xp             Int      @default(0)
  level          Int      @default(1)
  currentStreak  Int      @default(0)
  longestStreak  Int      @default(0)
  lastActiveDate String? // "YYYY-MM-DD" — sert au calcul du streak

  // RGPD
  consentAt       DateTime?
  marketingOptIn  Boolean   @default(false)
  deletedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  sessions        Session[]
  tokens          VerificationToken[]
  habits          Habit[]
  habitLogs       HabitLog[]
  tasks           Task[]
  goals           Goal[]
  goalSteps       GoalStep[]
  meals           Meal[]
  waterLogs       WaterLog[]
  weightEntries   WeightEntry[]
  workouts        Workout[]
  journalEntries  JournalEntry[]
  prayerLogs      PrayerLog[]
  prayerSettings  PrayerSettings?
  transactions    Transaction[]
  projects        Project[]
  notes           Note[]
  events          CalendarEvent[]
  focusSessions   FocusSession[]
  dailyStats      DailyStat[]
  badges          UserBadge[]
  xpEvents        XpEvent[]
  notifications   Notification[]
  conversations   AiConversation[]
  auditLogs       AuditLog[]

  @@index([email])
  @@map("users")
}

/// Session applicative — permet la revocation cote serveur (deconnexion globale).
model Session {
  id           String   @id @default(cuid())
  userId       String
  refreshToken String   @unique
  userAgent    String?
  ip           String?
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// Jeton a usage unique : verification d'email ou reinitialisation de mot de passe.
model VerificationToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique // hash SHA-256 du jeton envoye par email
  type      String // EMAIL_VERIFICATION | PASSWORD_RESET
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("verification_tokens")
}

// -----------------------------------------------------------------------------
//  HABITUDES
// -----------------------------------------------------------------------------

model Habit {
  id          String  @id @default(cuid())
  userId      String
  name        String
  description String?
  icon        String  @default("check")
  color       String  @default("#6366f1")
  category    String  @default("other") // health|spirituality|mind|work|sport|social|other
  frequency   String  @default("daily") // daily | weekly | custom
  weekDays    String  @default("[0,1,2,3,4,5,6]") // JSON: jours actifs (0 = dimanche)
  targetPerDay Int    @default(1)
  unit        String? // verres, pages, minutes...
  importance  Int     @default(2) // 1 = faible, 2 = normale, 3 = critique
  xpReward    Int     @default(10)
  reminderAt  String? // "HH:mm"
  isNegative  Boolean @default(false) // habitude a eviter (ex : reseaux sociaux)
  archivedAt  DateTime?
  position    Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs HabitLog[]

  @@index([userId, archivedAt])
  @@map("habits")
}

model HabitLog {
  id      String   @id @default(cuid())
  userId  String
  habitId String
  date    String // "YYYY-MM-DD" dans le fuseau de l'utilisateur
  count   Int      @default(1)
  status  String   @default("done") // done | skipped | failed
  note    String?
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
  @@index([userId, date])
  @@map("habit_logs")
}

// -----------------------------------------------------------------------------
//  TACHES & OBJECTIFS
// -----------------------------------------------------------------------------

model Task {
  id          String    @id @default(cuid())
  userId      String
  parentId    String? // sous-tache
  goalId      String?
  projectId   String?
  title       String
  description String?
  priority    String    @default("medium") // low | medium | high | urgent
  status      String    @default("todo") // todo | doing | done | cancelled
  dueDate     DateTime?
  reminderAt  DateTime?
  completedAt DateTime?
  estimateMin Int?
  xpReward    Int       @default(5)
  tags        String    @default("[]") // JSON string[]
  position    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent   Task?    @relation("TaskSubtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks Task[]   @relation("TaskSubtasks")
  goal     Goal?    @relation(fields: [goalId], references: [id], onDelete: SetNull)
  project  Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([userId, dueDate])
  @@map("tasks")
}

model Goal {
  id          String    @id @default(cuid())
  userId      String
  parentId    String?
  title       String
  description String?
  category    String    @default("personal") // health|career|finance|spiritual|learning|personal
  horizon     String    @default("short") // short | mid | long
  priority    String    @default("medium")
  status      String    @default("active") // active | paused | done | abandoned
  progress    Int       @default(0) // 0-100, recalcule depuis les etapes
  targetValue Float?
  currentValue Float?
  unit        String?
  startDate   DateTime  @default(now())
  deadline    DateTime?
  completedAt DateTime?
  color       String    @default("#8b5cf6")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent   Goal?      @relation("GoalSubgoals", fields: [parentId], references: [id], onDelete: Cascade)
  subgoals Goal[]     @relation("GoalSubgoals")
  steps    GoalStep[]
  tasks    Task[]

  @@index([userId, status])
  @@map("goals")
}

model GoalStep {
  id          String    @id @default(cuid())
  userId      String
  goalId      String
  title       String
  done        Boolean   @default(false)
  completedAt DateTime?
  position    Int       @default(0)
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId])
  @@map("goal_steps")
}

// -----------------------------------------------------------------------------
//  NUTRITION & POIDS
// -----------------------------------------------------------------------------

model Meal {
  id       String   @id @default(cuid())
  userId   String
  date     String // "YYYY-MM-DD"
  type     String // breakfast | lunch | dinner | snack
  name     String
  calories Float    @default(0)
  protein  Float    @default(0)
  carbs    Float    @default(0)
  fat      Float    @default(0)
  fiber    Float    @default(0)
  quantity Float    @default(1)
  unit     String   @default("portion")
  isTemplate Boolean @default(false) // repas reutilisable cree par l'utilisateur
  aiGenerated Boolean @default(false)
  notes    String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@map("meals")
}

model WaterLog {
  id     String @id @default(cuid())
  userId String
  date   String
  amountMl Int  @default(250)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@map("water_logs")
}

model WeightEntry {
  id        String   @id @default(cuid())
  userId    String
  date      String // "YYYY-MM-DD"
  weightKg  Float
  bodyFat   Float?
  muscleKg  Float?
  photoUrl  String?
  note      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
  @@map("weight_entries")
}

// -----------------------------------------------------------------------------
//  SPORT
// -----------------------------------------------------------------------------

model Workout {
  id         String   @id @default(cuid())
  userId     String
  date       String
  name       String
  type       String   @default("strength") // strength | cardio | walk | run | swim | yoga | other
  durationMin Int     @default(0)
  distanceKm Float?
  calories   Float?
  avgHeartRate Int?
  intensity  String   @default("medium") // low | medium | high
  notes      String?
  aiGenerated Boolean @default(false)
  createdAt  DateTime @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercises Exercise[]

  @@index([userId, date])
  @@map("workouts")
}

model Exercise {
  id        String @id @default(cuid())
  workoutId String
  name      String
  sets      Int    @default(0)
  reps      Int    @default(0)
  weightKg  Float?
  restSec   Int?
  durationSec Int?
  position  Int    @default(0)

  workout Workout @relation(fields: [workoutId], references: [id], onDelete: Cascade)

  @@index([workoutId])
  @@map("exercises")
}

model FocusSession {
  id        String   @id @default(cuid())
  userId    String
  date      String
  label     String?
  minutes   Int
  taskId    String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@map("focus_sessions")
}

// -----------------------------------------------------------------------------
//  JOURNAL
// -----------------------------------------------------------------------------

model JournalEntry {
  id        String   @id @default(cuid())
  userId    String
  date      String // "YYYY-MM-DD" — une entree par jour
  mood      Int      @default(3) // 1..5
  energy    Int      @default(3) // 1..5
  title     String?
  content   String   @default("")
  gratitude String?
  tags      String   @default("[]") // JSON string[]
  media     String   @default("[]") // JSON {url,type,name}[]
  aiSummary String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
  @@map("journal_entries")
}

// -----------------------------------------------------------------------------
//  PRIERES
// -----------------------------------------------------------------------------

model PrayerSettings {
  id           String  @id @default(cuid())
  userId       String  @unique
  method       Int     @default(2) // identifiant de methode AlAdhan (2 = ISNA)
  school       Int     @default(0) // 0 = Shafi, 1 = Hanafi
  notifyBefore Int     @default(10) // minutes
  notifications Boolean @default(true)
  latitudeAdjustment Int @default(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("prayer_settings")
}

model PrayerLog {
  id     String @id @default(cuid())
  userId String
  date   String
  name   String // Fajr | Dhuhr | Asr | Maghrib | Isha
  status String @default("done") // done | late | missed
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date, name])
  @@index([userId, date])
  @@map("prayer_logs")
}

// -----------------------------------------------------------------------------
//  FINANCES / PROJETS / NOTES / AGENDA
// -----------------------------------------------------------------------------

model Transaction {
  id        String   @id @default(cuid())
  userId    String
  date      String
  type      String // income | expense
  category  String   @default("other")
  label     String
  amount    Float
  currency  String   @default("EUR")
  recurring Boolean  @default(false)
  note      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@map("transactions")
}

model Project {
  id          String    @id @default(cuid())
  userId      String
  name        String
  description String?
  status      String    @default("active") // active | paused | done | archived
  color       String    @default("#0ea5e9")
  deadline    DateTime?
  progress    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks Task[]
  notes Note[]

  @@index([userId, status])
  @@map("projects")
}

model Note {
  id        String   @id @default(cuid())
  userId    String
  projectId String?
  title     String
  content   String   @default("")
  tags      String   @default("[]")
  pinned    Boolean  @default(false)
  color     String   @default("#64748b")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("notes")
}

model CalendarEvent {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  startAt     DateTime
  endAt       DateTime
  allDay      Boolean  @default(false)
  location    String?
  color       String   @default("#6366f1")
  source      String   @default("local") // local | google | outlook | apple
  externalId  String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startAt])
  @@map("calendar_events")
}

// -----------------------------------------------------------------------------
//  STATISTIQUES & GAMIFICATION
// -----------------------------------------------------------------------------

/// Instantane agrege d'une journee. Recalcule a la volee et mis en cache ici,
/// ce qui rend la page « Comparaison » instantanee meme sur plusieurs annees.
model DailyStat {
  id             String @id @default(cuid())
  userId         String
  date           String
  habitsDone     Int    @default(0)
  habitsTotal    Int    @default(0)
  tasksDone      Int    @default(0)
  tasksTotal     Int    @default(0)
  prayersDone    Int    @default(0)
  calories       Float  @default(0)
  proteinG       Float  @default(0)
  waterMl        Int    @default(0)
  weightKg       Float?
  workoutMinutes Int    @default(0)
  focusMinutes   Int    @default(0)
  sleepHours     Float?
  readingMinutes Int    @default(0)
  mood           Int?
  xpEarned       Int    @default(0)
  disciplineScore Int   @default(0) // 0-100
  completionRate Int    @default(0) // 0-100
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
  @@map("daily_stats")
}

model Badge {
  id          String @id @default(cuid())
  code        String @unique
  name        String
  description String
  icon        String @default("award")
  tier        String @default("bronze") // bronze | silver | gold | platinum
  xpReward    Int    @default(50)

  users UserBadge[]

  @@map("badges")
}

model UserBadge {
  id         String   @id @default(cuid())
  userId     String
  badgeId    String
  unlockedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@map("user_badges")
}

model XpEvent {
  id        String   @id @default(cuid())
  userId    String
  amount    Int
  reason    String
  source    String // habit | task | goal | workout | prayer | journal | streak | badge
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("xp_events")
}

// -----------------------------------------------------------------------------
//  NOTIFICATIONS, IA, AUDIT
// -----------------------------------------------------------------------------

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String // habit | task | prayer | water | sleep | goal | system
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  scheduledAt DateTime?
  sentAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

model AiConversation {
  id        String   @id @default(cuid())
  userId    String
  title     String   @default("Nouvelle conversation")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AiMessage[]

  @@index([userId, updatedAt])
  @@map("ai_conversations")
}

model AiMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String // user | assistant | tool
  content        String
  toolCalls      String? // JSON des actions executees, affichees dans l'UI
  tokensIn       Int      @default(0)
  tokensOut      Int      @default(0)
  createdAt      DateTime @default(now())

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("ai_messages")
}

/// Journalisation des actions sensibles (RGPD / tracabilite).
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String // LOGIN | LOGOUT | REGISTER | PASSWORD_RESET | DATA_EXPORT | DELETE_ACCOUNT | AI_ACTION
  entity    String?
  entityId  String?
  ip        String?
  userAgent String?
  meta      String? // JSON
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@map("audit_logs")
}
